<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:orientation="vertical">

    <include layout="@layout/layout_toolbar" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="24dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_header" android:gravity="center_horizontal"
                android:orientation="vertical" android:padding="24dp">
                <FrameLayout xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:layout_width="88dp" android:layout_height="88dp">
                    <TextView android:id="@+id/tvInitials"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar" android:gravity="center" android:text="?"
                        android:textColor="@color/primary_dark" android:textSize="32sp" android:textStyle="bold" />
                    <com.google.android.material.imageview.ShapeableImageView android:id="@+id/imgPhoto"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:scaleType="centerCrop" android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/CircleImage" />
                </FrameLayout>
                <TextView android:id="@+id/tvName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvHeadline" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:gravity="center" android:textColor="#E6FFFFFF" android:textSize="14sp" />
                <TextView android:id="@+id/tvCollege" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:gravity="center" android:textColor="#B3FFFFFF" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <Button android:id="@+id/btnGithub" style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:paddingStart="2dp" android:paddingEnd="2dp" android:text="GitHub" android:textSize="12sp" />
                <Button android:id="@+id/btnLinkedin" style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:paddingStart="2dp" android:paddingEnd="2dp" android:text="LinkedIn" android:textSize="12sp" />
                <Button android:id="@+id/btnResume" style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:paddingStart="2dp" android:paddingEnd="2dp" android:text="Resume" android:textSize="12sp" />
                <Button android:id="@+id/btnShare" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:paddingStart="2dp" android:paddingEnd="2dp"
                    android:text="Share" android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView style="@style/App.Card"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView style="@style/App.Section" android:layout_marginTop="0dp" android:text="About" />
                    <TextView android:id="@+id/tvAbout" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="14sp" />
                    <TextView android:id="@+id/tvDetails" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_secondary" android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/App.Card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView style="@style/App.Section" android:layout_marginTop="0dp" android:text="Skills" />
                    <com.google.android.material.chip.ChipGroup android:id="@+id/chipSkills"
                        android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/App.Section" android:layout_marginStart="16dp" android:text="Projects" />
            <LinearLayout android:id="@+id/projectsContainer" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingStart="12dp" android:paddingEnd="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>